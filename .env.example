APP_NAME="MR-Lana ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Producción: APP_ENV=production, APP_DEBUG=false y APP_URL con https://

APP_LOCALE=es
# lang/es contiene las traducciones; el respaldo en inglés solo cubre claves que falten (nunca se muestra "validation.required").
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mrlana
DB_USERNAME=root
DB_PASSWORD=
# Las tablas nuevas se crean siempre en InnoDB (llaves foráneas y transacciones).
# DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# Cola: notificaciones y correos se encolan en la tabla `jobs`.
# Requiere un worker permanente (Supervisor o systemd, ver docs/despliegue.md).
# Sin worker activo, las notificaciones y correos encolados NO se entregan.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# ERP
# ---------------------------------------------------------------------------
# Correo general que recibe avisos del sistema (opcional).
ERP_NOTIFY_EMAIL=
# URL pública del ERP usada en correos y PDF.
ERP_URL=https://erp.example.com
ERP_SUPPORT_URL=https://soporte.example.com
# Registro público de cuentas desde la pantalla de acceso (recomendado: false).
ERP_ALLOW_REGISTRATION=false
# Zona horaria para "hoy" en reglas de negocio (fecha de solicitud, etc.).
ERP_BUSINESS_TIMEZONE=America/Mexico_City
# Respaldo de la URL de "Descargar aplicación" si no se define en Configuración.
# Vacío = botón deshabilitado.
ERP_MOBILE_APP_URL=
# Correos de respaldo para avisos de requisiciones, separados por comas (opcional).
REQUISICION_NOTIFY_TO=
# Solo para emergencias: permite rollbacks que borran información real.
# Úsalo temporalmente y con un respaldo verificado.
ERP_ALLOW_DESTRUCTIVE_ROLLBACK=false

# ---------------------------------------------------------------------------
# PDF
# ---------------------------------------------------------------------------
# browsershot (Chrome headless) o dompdf. Si Browsershot falla, se usa DomPDF.
ERP_PDF_DRIVER=browsershot
# Rutas absolutas en el servidor (vacío = autodetección).
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
# true cuando PHP corre como usuario sin privilegios en Linux (www-data).
BROWSERSHOT_NO_SANDBOX=true
BROWSERSHOT_TIMEOUT=60

# ---------------------------------------------------------------------------
# Tiempo real (Laravel Reverb). Sin Reverb, la campana consulta cada 45 s.
# ---------------------------------------------------------------------------
# reverb en producción; log o null desactiva el envío por WebSocket.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Host/puerto públicos que usa el navegador (detrás de Nginx: dominio y 443).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Dirección donde escucha el proceso `php artisan reverb:start`.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
# Se incrustan al compilar (npm run build): recompila si cambian.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
